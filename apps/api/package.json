{
  "name": "@ai-car-sales-crm/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "lint": "oxlint . --tsconfig tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run src/modules/tenancy/tenant-scoped-crm.integration.spec.ts src/modules/auth/auth.integration.spec.ts",
    "auth:bootstrap:local": "tsx src/modules/auth/development-bootstrap.cli.ts --confirm-local-development",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@ai-car-sales-crm/shared-types": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.6.1",
    "pg": "^8.16.0",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.6.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.16.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
