generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DealershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleScope {
  GLOBAL
  DEALERSHIP
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PreferredLanguage {
  ENGLISH
  SINHALA
  SINGLISH
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  APPOINTMENT_SET
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

enum LeadSource {
  WEBSITE
  WALK_IN
  PHONE
  SMS
  REFERRAL
  SOCIAL
  OTHER
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  PENDING
  ERROR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  SYNC
}

model Dealership {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  slug      String           @unique
  status    DealershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  branches                  Branch[]
  memberships               DealershipMembership[]
  roles                     Role[]                     @relation("DealershipRoles")
  settings                  DealershipSettings?
  customers                 Customer[]
  leads                     Lead[]
  integrationConnections    IntegrationConnection[]
  inventorySyncLogs         InventorySyncLog[]
  externalVehicleReferences ExternalVehicleReference[]
  auditLogs                 AuditLog[]
}

model DealershipSettings {
  id                         String      @id @default(uuid()) @db.Uuid
  dealershipId               String      @unique @db.Uuid
  timezone                   String      @default("UTC")
  currency                   String      @default("USD")
  brandingName               String?
  defaultLeadSource          LeadSource? @default(WEBSITE)
  allowExternalInventorySync Boolean     @default(false)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  dealershipId String       @db.Uuid
  name         String
  code         String
  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  status       BranchStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  dealership  Dealership             @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  memberships DealershipMembership[]

  @@unique([dealershipId, id])
  @@unique([dealershipId, code])
  @@index([dealershipId, status])
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships     DealershipMembership[]
  platformRoles   UserRole[]
  leadAssignments LeadAssignment[]
  leadActivities  LeadActivity[]
  auditLogs       AuditLog[]

  @@index([status])
}

model DealershipMembership {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  dealershipId String           @db.Uuid
  branchId     String?          @db.Uuid
  isPrimary    Boolean          @default(false)
  status       MembershipStatus @default(INVITED)
  joinedAt     DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  dealership         Dealership       @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  branch             Branch?          @relation(fields: [dealershipId, branchId], references: [dealershipId, id], onDelete: Restrict)
  roles              MembershipRole[] @relation("MembershipRoleAssignments")
  leadAssignments    LeadAssignment[] @relation("AssignedMembership")
  assignmentsCreated LeadAssignment[] @relation("AssigningMembership")
  leadActivities     LeadActivity[]   @relation("ActivityMembership")

  @@unique([userId, dealershipId])
  @@unique([dealershipId, id])
  @@unique([dealershipId, id, userId])
  @@index([userId, status])
  @@index([dealershipId, status])
  @@map("UserDealership")
}

model Role {
  id           String    @id @default(uuid()) @db.Uuid
  dealershipId String?   @db.Uuid
  name         String
  key          String
  scope        RoleScope @default(DEALERSHIP)
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  dealership    Dealership?      @relation("DealershipRoles", fields: [dealershipId], references: [id], onDelete: Restrict)
  permissions   RolePermission[]
  memberships   MembershipRole[] @relation("DealershipRoleAssignments")
  platformUsers UserRole[]       @relation("PlatformRoleAssignments")

  @@unique([dealershipId, key])
  @@unique([dealershipId, id])
  @@unique([id, scope])
  @@index([scope])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model MembershipRole {
  dealershipId String   @db.Uuid
  membershipId String   @db.Uuid
  roleId       String   @db.Uuid
  assignedAt   DateTime @default(now())

  membership DealershipMembership @relation("MembershipRoleAssignments", fields: [dealershipId, membershipId], references: [dealershipId, id], onDelete: Restrict)
  role       Role                 @relation("DealershipRoleAssignments", fields: [dealershipId, roleId], references: [dealershipId, id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([dealershipId, roleId])
}

model UserRole {
  userId     String    @db.Uuid
  roleId     String    @db.Uuid
  roleScope  RoleScope @default(GLOBAL)
  assignedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation("PlatformRoleAssignments", fields: [roleId, roleScope], references: [id, scope], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId, roleScope])
}

model Customer {
  id                String            @id @default(uuid()) @db.Uuid
  dealershipId      String            @db.Uuid
  firstName         String
  lastName          String
  email             String?
  phone             String?
  preferredLanguage PreferredLanguage @default(ENGLISH)
  status            CustomerStatus    @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  leads      Lead[]

  @@unique([dealershipId, id])
  @@index([dealershipId, createdAt])
  @@index([dealershipId, email])
  @@index([dealershipId, phone])
}

model Lead {
  id           String     @id @default(uuid()) @db.Uuid
  dealershipId String     @db.Uuid
  customerId   String     @db.Uuid
  title        String
  source       LeadSource @default(WEBSITE)
  status       LeadStatus @default(NEW)
  score        Int        @default(0)
  budget       Decimal?   @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  dealership  Dealership       @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  customer    Customer         @relation(fields: [dealershipId, customerId], references: [dealershipId, id], onDelete: Restrict)
  assignments LeadAssignment[]
  activities  LeadActivity[]

  @@unique([dealershipId, id])
  @@index([dealershipId, status, createdAt])
  @@index([dealershipId, customerId])
}

model LeadAssignment {
  id                     String    @id @default(uuid()) @db.Uuid
  leadId                 String    @db.Uuid
  userId                 String    @db.Uuid
  dealershipId           String    @db.Uuid
  membershipId           String    @db.Uuid
  assignedByMembershipId String?   @db.Uuid
  assignedAt             DateTime  @default(now())
  unassignedAt           DateTime?

  lead       Lead                  @relation(fields: [dealershipId, leadId], references: [dealershipId, id], onDelete: Restrict)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership DealershipMembership  @relation("AssignedMembership", fields: [dealershipId, membershipId, userId], references: [dealershipId, id, userId], onDelete: Restrict)
  assignedBy DealershipMembership? @relation("AssigningMembership", fields: [dealershipId, assignedByMembershipId], references: [dealershipId, id], onDelete: Restrict)

  @@unique([dealershipId, id])
  @@index([dealershipId, leadId, unassignedAt])
  @@index([dealershipId, membershipId, unassignedAt])
}

model LeadActivity {
  id                String   @id @default(uuid()) @db.Uuid
  leadId            String   @db.Uuid
  userId            String?  @db.Uuid
  dealershipId      String   @db.Uuid
  actorMembershipId String?  @db.Uuid
  action            String
  details           String?
  metadata          Json?
  createdAt         DateTime @default(now())

  lead            Lead                  @relation(fields: [dealershipId, leadId], references: [dealershipId, id], onDelete: Restrict)
  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorMembership DealershipMembership? @relation("ActivityMembership", fields: [dealershipId, actorMembershipId, userId], references: [dealershipId, id, userId], onDelete: Restrict)

  @@index([dealershipId, leadId, createdAt])
}

model IntegrationConnection {
  id                  String            @id @default(uuid()) @db.Uuid
  dealershipId        String            @db.Uuid
  name                String
  type                String
  provider            String
  isEnabled           Boolean           @default(false)
  status              IntegrationStatus @default(PENDING)
  configuration       Json?
  credentialReference String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lastSyncedAt        DateTime?

  dealership                Dealership                 @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  syncLogs                  InventorySyncLog[]
  externalVehicleReferences ExternalVehicleReference[]

  @@unique([dealershipId, id])
  @@index([dealershipId, status])
}

model InventorySyncLog {
  id               String    @id @default(uuid()) @db.Uuid
  dealershipId     String    @db.Uuid
  connectionId     String?   @db.Uuid
  jobType          String
  status           String    @default("queued")
  recordsProcessed Int       @default(0)
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  errorMessage     String?
  metadata         Json?

  dealership Dealership             @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  connection IntegrationConnection? @relation(fields: [dealershipId, connectionId], references: [dealershipId, id], onDelete: Restrict)

  @@unique([dealershipId, id])
  @@index([dealershipId, status, startedAt])
  @@index([dealershipId, connectionId, startedAt])
}

model ExternalVehicleReference {
  id           String   @id @default(uuid()) @db.Uuid
  dealershipId String   @db.Uuid
  connectionId String   @db.Uuid
  sourceSystem String
  externalId   String
  vin          String?
  stockNumber  String?
  make         String?
  model        String?
  year         Int?
  trim         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dealership Dealership            @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  connection IntegrationConnection @relation(fields: [dealershipId, connectionId], references: [dealershipId, id], onDelete: Restrict)

  @@unique([dealershipId, sourceSystem, externalId])
  @@index([dealershipId, connectionId])
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  dealershipId String?     @db.Uuid
  userId       String?     @db.Uuid
  entityType   String
  entityId     String
  action       AuditAction
  details      String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  dealership Dealership? @relation(fields: [dealershipId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([dealershipId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
}
