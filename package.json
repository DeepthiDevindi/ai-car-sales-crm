{
  "name": "ai-car-sales-crm",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@9.15.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"pnpm --dir apps/api start:dev\" \"pnpm --dir apps/web dev\"",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --dir apps/api prisma generate",
    "db:migrate": "pnpm --dir apps/api prisma migrate dev --name init",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "oxlint": "^1.90.0"
  }
}
